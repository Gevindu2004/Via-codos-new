# Server Configuration
PORT=4000
CORS_ORIGIN="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# Azure SQL Database Connection String
# Format: sqlserver://<server>.database.windows.net:1433;database=<db-name>;user=<username>;password=<password>;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30
DATABASE_URL="sqlserver://YOUR_SERVER.database.windows.net:1433;database=viacodos_db;user=YOUR_ADMIN;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30"

# JWT Session Secret (replace with a strong 32+ byte random string)
AUTH_SECRET="replace-with-random-32-byte-secret"

# Seed Passwords (used when running npm run db:seed)
SEED_ADMIN_PASSWORD=""
SEED_EDITOR_PASSWORD=""
SEED_CLIENT_PASSWORD=""

# SMTP Email Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Via Codos Legal & Operations <info@viacodos.com>"
ADMIN_NOTIFY_EMAIL="info@viacodos.com"

