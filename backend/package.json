{
  "name": "via-codos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Express + Prisma (Azure SQL) Backend API for Via Codos Enterprise Platform",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.6",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.1",
    "prisma": "^6.16.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}

