generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. ADMIN AUTH, AUDIT LOGS & CONTENT VERSIONING
// ============================================================================

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("SUPER_ADMIN") // SUPER_ADMIN | EDITOR | LEGAL_ADMIN | RECRUITER
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id          String     @id @default(cuid())
  actorId     String?
  actor       AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  actorRole   String
  action      String     // CREATE | UPDATE | DELETE | PUBLISH | UNPUBLISH | ROLLBACK | APPROVE | REJECT | SIGN | CONVERT_APPLICANT | VERIFY_CLIENT
  entityType  String     // CmsPage | Service | Industry | CaseStudy | InsightArticle | LegalDocument | TalentProfile | ProfileRequest | JobApplication | MenuItem | SiteSetting | SaasProduct
  entityId    String
  entityLabel String
  summary     String
  beforeJson  String?
  afterJson   String?
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ContentVersion {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  versionNumber  Int
  snapshotJson   String
  changeNote     String?
  createdByEmail String
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, versionNumber])
}

// ============================================================================
// 2. CMS PAGES, SECTIONS, MENUS, CATEGORIES, MEDIA & SETTINGS
// ============================================================================

model SiteSetting {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id           String   @id @default(cuid())
  location     String   // HEADER | HEADER_CONSOLE | FOOTER_COMPANY | FOOTER_RESOURCES | FOOTER_LEGAL
  label        String
  href         String
  groupName    String?
  icon         String?
  parentId     String?
  sortOrder    Int      @default(0)
  isVisible    Boolean  @default(true)
  openInNewTab Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([location, sortOrder])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  scope       String    @default("PAGE") // PAGE | INSIGHT | SERVICE | TALENT | CAREER
  description String?
  sortOrder   Int       @default(0)
  pages       CmsPage[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CmsPage {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  subtitle        String?
  metaTitle       String?
  metaDescription String?
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  template        String       @default("STANDARD") // STANDARD | LANDING | TWO_COLUMN
  status          String       @default("PUBLISHED") // DRAFT | PUBLISHED
  isSystem        Boolean      @default(false)
  publishedAt     DateTime?
  updatedBy       String?
  sections        CmsSection[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model CmsSection {
  id         String   @id @default(cuid())
  pageId     String
  page       CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionKey String
  type       String   @default("RICH_TEXT") // HERO | RICH_TEXT | CARDS_GRID | STATS_GRID | TWO_COL | CTA_BAND | FAQ | VIDEO_SHOWCASE
  title      String?
  subtitle   String?
  bodyHtml   String?
  dataJson   String?  // structured cards, stats, CTA buttons, etc.
  imageUrl   String?
  sortOrder  Int      @default(0)
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pageId, sortOrder])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  altText      String?
  folder       String   @default("general")
  uploadedBy   String?
  createdAt    DateTime @default(now())
}

// ============================================================================
// 3. CORPORATE SERVICES, INDUSTRIES, PORTFOLIO, INSIGHTS, TEAM, FEEDBACK
// ============================================================================

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  groupName       String   // Talent & Products | Custom Development | Run & Scale
  icon            String   @default("code")
  tagline         String
  metaTitle       String
  metaDescription String
  oneliner        String
  bodyJson        String   // JSON string[] of paragraphs or HTML
  includedJson    String   // JSON string[]
  disciplinesJson String?  // JSON [{icon, title, desc}]
  levelsJson      String?  // JSON [{icon, title, years, desc}]
  statValue       String
  statLabel       String
  videoUrl        String?
  posterUrl       String?
  sortOrder       Int      @default(0)
  status          String   @default("PUBLISHED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Industry {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  icon           String   @default("building")
  metaTitle      String
  intro          String
  challengesJson String   // JSON string[]
  solutionsJson  String   // JSON string[]
  sortOrder      Int      @default(0)
  status         String   @default("PUBLISHED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CaseStudy {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  sector             String
  imageUrl           String
  videoUrl           String?
  posterUrl          String?
  metaTitle          String
  metaDescription    String
  headline           String
  clientDesc         String
  challenge          String
  solution           String
  implementationJson String   // JSON string[]
  resultsJson        String   // JSON [{value, label}]
  quote              String
  sortOrder          Int      @default(0)
  status             String   @default("PUBLISHED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model InsightArticle {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  category   String
  dateLabel  String
  readTime   String
  excerpt    String
  bodyHtml   String
  coverImage String?
  status     String   @default("PUBLISHED")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  imageUrl  String?
  bio       String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String?
  country   String?
  imageUrl  String?
  quote     String
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// 4. SAAS PRODUCTS & CODOS CONSOLE
// ============================================================================

model SaasProduct {
  id                 String   @id @default(cuid())
  slug               String   @unique // skybeak | thumbs-up-apis | call-colleague
  name               String
  tagline            String
  badge              String?
  summary            String
  descriptionHtml    String
  featuresJson       String   // JSON [{title, desc, icon}]
  metricsJson        String   // JSON [{value, label}]
  pricingTiersJson   String   // JSON [{name, price, period, features[]}]
  heroImage          String?
  consolePath        String   // /codos-console?product=skybeak
  externalConsoleUrl String?
  sortOrder          Int      @default(0)
  status             String   @default("PUBLISHED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================================================
// 5. LEGAL DOCUMENTS, TEMPLATES & E-SIGN + EMAIL OUTBOX
// ============================================================================

model LegalDocumentType {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  description       String?
  isPublicPolicy    Boolean         @default(true)
  isPrivateTemplate Boolean         @default(false)
  documents         LegalDocument[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model LegalDocument {
  id                String             @id @default(cuid())
  typeId            String
  type              LegalDocumentType  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  slug              String             @unique
  title             String
  version           String             @default("1.0")
  effectiveDate     DateTime           @default(now())
  summary           String?
  contentHtml       String
  status            String             @default("PUBLISHED") // DRAFT | PUBLISHED
  isTemplate        Boolean            @default(false)
  isPublic          Boolean            @default(true)
  updatedBy         String?
  signatureRequests SignatureRequest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model SignatureRequest {
  id                    String        @id @default(cuid())
  token                 String        @unique
  documentId            String
  document              LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentTitle         String
  documentVersion       String
  renderedHtml          String
  clientName            String
  clientEmail           String
  clientCompany         String?
  partyBName            String        @default("Via Codos (PVT) LTD")
  partyBEmail           String        @default("info@viacodos.com")
  pipelineRequestId     String?       // optional link to ProfileRequest
  status                String        @default("PENDING") // PENDING | VIEWED | SIGNED | EXPIRED | CANCELLED
  signatureMode         String?       // DRAW | TYPE | UPLOAD
  signatureDataUrl      String?
  signaturePositionJson String?       // {xPct, yPct, page, widthPct}
  signerFullName        String?
  signerTitle           String?
  signedDateText        String?
  agreedToElectronic    Boolean       @default(false)
  signerIp              String?
  verificationHash      String?
  signedPdfPath         String?
  signedAt              DateTime?
  createdBy             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([pipelineRequestId])
}

model EmailOutbox {
  id             String   @id @default(cuid())
  toEmail        String
  ccEmail        String?
  subject        String
  bodyText       String
  attachmentPath String?
  status         String   @default("LOGGED_LOCAL") // SENT | LOGGED_LOCAL | FAILED
  errorMessage   String?
  relatedEntity  String?
  createdAt      DateTime @default(now())
}

// ============================================================================
// 6. ANONYMIZED TALENT BENCH & STAFFING INQUIRIES
// ============================================================================

model TalentDomain {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String   // IT | MANAGEMENT
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TalentProfile {
  id                  String           @id @default(cuid())
  profileCode         String           @unique // e.g., VC-IT-001, VC-MG-001
  displayName         String?
  category            String           // IT | MANAGEMENT
  domainSlug          String
  domainName          String
  roleTitle           String
  summary             String
  skillsJson          String           // JSON string[]
  yearsExperience     Int
  projectsJson        String           // JSON [{title, scope, outcome, stack}] - strictly anonymized
  industriesJson      String           // JSON string[]
  availability        String           @default("IMMEDIATE") // IMMEDIATE | TWO_WEEKS | ONE_MONTH | PART_TIME
  hourlyRateUsd       Int
  monthlyRateUsd      Int
  visibilityFlag      String           @default("SAMPLE") // SAMPLE | REAL
  placementStatus     String           @default("AVAILABLE") // AVAILABLE | PLACED
  internalCandidateId String?          // private reference only
  status              String           @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  profileRequests     ProfileRequest[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([category, domainSlug, status])
}

model StaffingInquiry {
  id              String   @id @default(cuid())
  referenceCode   String   @unique
  name            String
  email           String
  company         String?
  phone           String?
  serviceLine     String
  roleNeeded      String?
  domain          String?
  skillsText      String?
  headcount       Int      @default(1)
  engagementModel String?  // Dedicated Full-Time | Fractional | Pod | Project
  timeline        String?
  timezoneOverlap String?
  message         String
  ndaRequired     Boolean  @default(true)
  status          String   @default("NEW") // NEW | CONTACTED | QUALIFIED | CLOSED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// 7. CLIENT PORTAL, VERIFICATION, PROFILE REQUESTS, AI INTERVIEWS, MEETINGS
// ============================================================================

model ClientUser {
  id                 String           @id @default(cuid())
  name               String
  email              String           @unique
  passwordHash       String
  companyName        String
  companyWebsite     String?
  companyCountry     String?
  jobTitle           String?
  phone              String?
  verificationStatus String           @default("PENDING") // PENDING | VERIFIED | REJECTED
  verificationNotes  String?
  verifiedAt         DateTime?
  profileRequests    ProfileRequest[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model ProfileRequest {
  id                  String              @id @default(cuid())
  clientId            String
  client              ClientUser          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  talentId            String
  talent              TalentProfile       @relation(fields: [talentId], references: [id], onDelete: Cascade)
  stage               String              @default("REQUESTED") // REQUESTED | APPROVED | INTERVIEW | MEETING | CONTRACT | HIRED | REJECTED
  requestNotes        String?
  adminApprovalNotes  String?
  approvedAt          DateTime?
  approvedBy          String?
  releasedDossierJson String?             // full anonymized engineering dossier released on admin approval
  interviews          AiInterviewSession[]
  meetings            ManagementMeeting[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([clientId, stage])
}

model AiInterviewSession {
  id                    String         @id @default(cuid())
  pipelineRequestId     String
  pipelineRequest       ProfileRequest @relation(fields: [pipelineRequestId], references: [id], onDelete: Cascade)
  token                 String         @unique
  scheduledSlot         DateTime
  timezone              String         @default("UTC")
  candidateInviteSentAt DateTime?
  questionsJson         String         // JSON string[]
  status                String         @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED
  recordingUrl          String?
  transcriptJson        String?        // JSON [{question, answer, timestamp, aiEvaluation}]
  aiSummary             String?
  overallScore          Int?
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model ManagementMeeting {
  id                String         @id @default(cuid())
  pipelineRequestId String
  pipelineRequest   ProfileRequest @relation(fields: [pipelineRequestId], references: [id], onDelete: Cascade)
  scheduledSlot     DateTime
  timezone          String         @default("UTC")
  meetingLink       String?
  attendeesJson     String         // JSON string[]
  notes             String?
  status            String         @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

// ============================================================================
// 8. CAREERS BOARD & REAL-CANDIDATE SCREENING PIPELINE
// ============================================================================

model JobDomain {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  category      String       @default("IT") // IT | MANAGEMENT
  isAutoCreated Boolean      @default(false)
  postings      JobPosting[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model JobPosting {
  id                   String           @id @default(cuid())
  title                String
  domainId             String?
  domain               JobDomain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  domainSlug           String
  domainName           String
  employmentType       String           @default("Full-time")
  location             String           @default("Remote")
  experienceRequired   String
  skillsJson           String           // JSON string[]
  responsibilitiesJson String           // JSON string[]
  description          String?
  status               String           @default("PUBLISHED") // DRAFT | PUBLISHED | CLOSED
  applications         JobApplication[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model JobApplication {
  id                      String      @id @default(cuid())
  jobPostingId            String?
  jobPosting              JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  applicantName           String
  applicantEmail          String
  applicantPhone          String?
  portfolioUrl            String?
  domainName              String
  domainSlug              String
  skillsJson              String      // JSON string[]
  yearsExperience         Int
  expectedMonthlyRateUsd  Int?
  summary                 String?
  cvFileUrl               String?
  cvOriginalName          String?
  consentToProfile        Boolean     @default(false)
  screeningStatus         String      @default("NEW") // NEW | SCREENING | APPROVED | REJECTED | CONVERTED
  screeningNotes          String?
  convertedProfileId      String?
  replacedSampleProfileId String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([screeningStatus])
}

